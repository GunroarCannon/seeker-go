# Solana Network Configuration
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_NETWORK=devnet

# SKR Token Configuration (Devnet)
# Get these from your SPL token mint
VITE_SKR_MINT_ADDRESS=YOUR_SKR_MINT_ADDRESS_HERE
VITE_SKR_DECIMALS=6

# Treasury Wallet (for Vercel backend payout)
# WARNING: This is a sensitive key! Never commit to git.
# Use Vercel environment variables for production.
TREASURY_PRIVATE_KEY=YOUR_TREASURY_KEYPAIR_HERE

# Magicblock Configuration
# Get API key from https://magicblock.dev
VITE_MAGICBLOCK_API_KEY=YOUR_MAGICBLOCK_API_KEY_HERE

# API Endpoint
# For local development
VITE_API_ENDPOINT=http://localhost:3000/api
# For production on Vercel
# VITE_API_ENDPOINT=https://your-domain.vercel.app/api
